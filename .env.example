# Development settings with obviously fake values. Copy to .env and change what you need.
# Never put real secrets in this file; .env is ignored by git.
# Host names (postgres, rabbitmq, valkey, storage) are the Docker Compose service names.
# Running a process on your own machine instead of in Docker? Use localhost and the published ports.
# Every variable starts with QFE_. A missing or invalid required value stops the process at
# startup and prints every problem (docs/specs/FEAT-20261010-1203-config.md).

# --- Required: every process -----------------------------------------------------------------
QFE_SERVICE_NAME=qfe-dev
# on = send traces to QFE_OTLP_ENDPOINT. off = no telemetry (it is logged at startup).
QFE_TELEMETRY=off
# Required when QFE_TELEMETRY=on (the grafana/otel-lgtm container accepts OTLP over HTTP on 4318).
# QFE_OTLP_ENDPOINT=http://otel-lgtm:4318

# --- Required: api, worker, relay, maintenance (role qfe_app) ----------------------------------
QFE_DATABASE_URL=postgresql+asyncpg://qfe_app:dev-only-app-password@postgres:5432/qfe

# --- Required: migrate job only (role qfe_migrator) ----------------------------------------------
QFE_MIGRATOR_DATABASE_URL=postgresql+asyncpg://qfe_migrator:dev-only-migrator-password@postgres:5432/qfe

# --- Required: api, worker, relay -------------------------------------------------------------
QFE_RABBITMQ_URL=amqp://qfe:dev-only-rabbit-password@rabbitmq:5672/

# --- Required: api -------------------------------------------------------------------------------
QFE_VALKEY_URL=redis://valkey:6379/0
# At least 32 characters. Changing it logs everyone out.
QFE_JWT_SECRET=dev-only-change-me-dev-only-change-me
QFE_JWT_ISSUER=qfe
QFE_JWT_AUDIENCE=qfe-api
# Browser origins allowed to call the API, comma separated, scheme + host + port only. Never *.
QFE_CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Required: api, worker, maintenance (storage seen from inside Docker) ---------------------------
QFE_STORAGE_ENDPOINT_URL=http://storage:8333
QFE_STORAGE_ACCESS_KEY=dev-only-storage-access-key
QFE_STORAGE_SECRET_KEY=dev-only-storage-secret-key
QFE_STORAGE_BUCKET=qfe-dev
# Required: api only. The address clients use to reach storage; it must be a different host name
# than QFE_STORAGE_ENDPOINT_URL because presigned links are signed for this address.
QFE_STORAGE_PUBLIC_URL=http://localhost:8333

# --- Required: worker only -----------------------------------------------------------------------
# * = every job type this worker has code for (fine in development). Otherwise a comma list.
QFE_WORKER_JOB_TYPES=*

# --- Tuning (optional). Uncomment to change. Values shown are the defaults in code. --------------
# These are development starting values, not tuned (docs/specs/FEAT-20261010-1203-config.md).
# QFE_WORKER_CONCURRENCY=1
# QFE_LEASE_SECONDS=60
# QFE_HEARTBEAT_INTERVAL_SECONDS=20
# QFE_MESSAGE_HAND_BACK_DELAY_SECONDS=5
# QFE_MAX_ATTEMPTS=3
# QFE_RETRY_BASE_DELAY_SECONDS=10
# QFE_RETRY_MAX_DELAY_SECONDS=300
# QFE_SWEEP_BASE_WAIT_SECONDS=300
# QFE_SWEEP_MAX_WAIT_SECONDS=3600
# QFE_SWEEP_BATCH_SIZE=100
# QFE_ACTIVE_JOBS_CAP=100
# QFE_RATE_LIMIT_API_KEY_PER_MINUTE=600
# QFE_RATE_LIMIT_ORGANISATION_PER_MINUTE=1200
# QFE_RATE_LIMIT_AUTH_ATTEMPTS_PER_WINDOW=10
# QFE_RATE_LIMIT_AUTH_WINDOW_SECONDS=900
# QFE_RATE_LIMIT_REFRESH_PER_IP_PER_MINUTE=60
# QFE_RATE_LIMIT_REFRESH_PER_USER_PER_MINUTE=30
# QFE_PRESIGNED_UPLOAD_TTL_SECONDS=900
# QFE_PRESIGNED_DOWNLOAD_TTL_SECONDS=300
# QFE_MAX_FILE_BYTES=104857600
# QFE_PENDING_FILE_EXPIRY_SECONDS=86400
# QFE_JOB_RETENTION_DAYS=30
# QFE_PUBLISHED_OUTBOX_RETENTION_SECONDS=86400
# QFE_MAX_PAYLOAD_BYTES=262144
# QFE_MAX_RESULT_BYTES=262144
# QFE_ACCESS_TOKEN_TTL_SECONDS=900
# QFE_REFRESH_REUSE_WINDOW_SECONDS=20
# QFE_LOGIN_LIFETIME_DAYS=30
