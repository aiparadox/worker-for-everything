# Settings for tests that run on your machine against the test services
# (docker compose --profile test). Loaded on top of .env, which supplies the passwords
# (QFE_APP_DB_PASSWORD and the others). Copy to .env.test.
# Test services listen on other ports than the development ones; see compose.yaml.
# These use 127.0.0.1, not localhost: on Windows "localhost" tries ::1 first and every new
# connection then waits about 2 seconds before falling back.
QFE_SERVICE_NAME=qfe-test
QFE_TELEMETRY=off
QFE_DATABASE_URL=postgresql+asyncpg://qfe_app:${QFE_APP_DB_PASSWORD}@127.0.0.1:15432/qfe
QFE_MIGRATOR_DATABASE_URL=postgresql+asyncpg://qfe_migrator:${QFE_MIGRATOR_DB_PASSWORD}@127.0.0.1:15432/qfe
QFE_RABBITMQ_URL=amqp://${QFE_RABBITMQ_USER}:${QFE_RABBITMQ_PASSWORD}@127.0.0.1:15673/
QFE_VALKEY_URL=redis://127.0.0.1:16379/0
# Reached from the host, so the "internal" and the public address are both localhost here; the
# api's rule that they must differ applies to real services, not to a test client.
QFE_STORAGE_ENDPOINT_URL=http://127.0.0.1:18333
QFE_STORAGE_PUBLIC_URL=http://127.0.0.1:18333
QFE_STORAGE_BUCKET=qfe-test
